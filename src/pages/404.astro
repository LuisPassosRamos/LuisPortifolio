---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { projectUrl, url } from '../lib/paths';
---

<Base title="Página não encontrada" description="O endereço não existe neste site.">
  <section class="nf">
    <div class="wrap">
      <p class="eyebrow">Erro 404</p>
      <h1>Este cabo não leva a lugar nenhum.</h1>
      <p class="lead">O endereço não existe ou mudou. Estes caminhos funcionam:</p>
      <ul>
        <li><a class="arrow-link" href={url()}>Página inicial</a></li>
        {
          projects.map((project) => (
            <li>
              <a class="arrow-link" href={projectUrl(project.slug)}>
                {project.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(56px, 10vw, 140px);
  }

  .nf .wrap {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    max-width: 18ch;
  }

  ul {
    display: grid;
    gap: 4px;
    margin-top: 8px;
  }

  li a {
    min-height: 44px;
  }
</style>
