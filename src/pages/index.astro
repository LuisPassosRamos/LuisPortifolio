---
import Base from '../layouts/Base.astro';
import HeroCircuit from '../components/HeroCircuit.astro';
import LogicDemo from '../components/LogicDemo.astro';
import OlympusFlow from '../components/visuals/OlympusFlow.astro';
import { about, capabilities, experience, profile } from '../data/profile';
import { featuredProjects, getProject, otherProjects } from '../data/projects';
import { projectUrl } from '../lib/paths';

const first = getProject(profile.startWith);
const olympus = getProject('olympus-3d');
const logicgates = getProject('logicgates');
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{profile.name} · {profile.role}</p>
        <h1>{profile.headline}</h1>
        <p class="lead">{profile.lead}</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href={projectUrl(first.slug)}>Comece pelo {first.title}</a>
          <a class="btn btn--ghost" href={profile.links.github} rel="me noopener">GitHub</a>
          <a class="btn btn--ghost" href={profile.links.linkedin} rel="me noopener">LinkedIn</a>
        </div>
        <p class="hero-meta">{profile.location}</p>
      </div>
      <div class="hero-art">
        <HeroCircuit />
      </div>
    </div>
  </section>

  <section class="section" id="projetos" aria-labelledby="projetos-titulo">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Projetos</p>
        <h2 id="projetos-titulo">Cinco trabalhos, cada um com uma prova diferente</h2>
        <p>
          Um sistema em uso, um mod que é meu TCC, uma automação do estágio e dois trabalhos da
          graduação. Cada case diz o que resolve, o que eu fiz e onde estão os limites.
        </p>
      </div>

      <article class="feature reveal" aria-labelledby="feat-olympus">
        <div class="feature-copy">
          <p class="tag tag--olympus">{olympus.kind}</p>
          <h3 id="feat-olympus">
            <a href={projectUrl(olympus.slug)}>{olympus.title}</a>
            <span>{olympus.subtitle}</span>
          </h3>
          <p>{olympus.summary}</p>
          <ul class="facts">
            {olympus.facts?.map((fact) => <li>{fact}</li>)}
          </ul>
          <a class="arrow-link" href={projectUrl(olympus.slug)} aria-label={`Ler o case ${olympus.title}`}>
            Ler o case
          </a>
        </div>
        <figure class="feature-visual panel">
          <OlympusFlow />
          <figcaption class="panel-caption">{olympus.visualCaption}</figcaption>
        </figure>
      </article>

      <article class="feature feature--flip reveal" aria-labelledby="feat-logic">
        <div class="feature-copy">
          <p class="tag">{logicgates.kind}</p>
          <h3 id="feat-logic">
            <a href={projectUrl(logicgates.slug)}>{logicgates.title}</a>
            <span>{logicgates.subtitle}</span>
          </h3>
          <p>{logicgates.summary}</p>
          <ul class="facts">
            {logicgates.facts?.map((fact) => <li>{fact}</li>)}
          </ul>
          <a class="arrow-link" href={projectUrl(logicgates.slug)} aria-label={`Ler o case ${logicgates.title}`}>
            Ler o case
          </a>
        </div>
        <figure class="feature-visual panel">
          <LogicDemo id="home-demo" headingLevel="h4" />
          <figcaption class="panel-caption">{logicgates.visualCaption}</figcaption>
        </figure>
      </article>

      <ol class="rows">
        {
          otherProjects.map((project, index) => (
            <li class="row reveal">
              <span class="row-index" aria-hidden="true">
                {String(featuredProjects.length + index + 1).padStart(2, '0')}
              </span>
              <div class="row-main">
                <h3>
                  <a href={projectUrl(project.slug)}>{project.title}</a>
                </h3>
                <p class="row-sub">{project.subtitle}</p>
              </div>
              <p class="row-summary">{project.summary}</p>
              <p class="row-kind">{project.kind}</p>
              <span class="row-arrow" aria-hidden="true">
                →
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt" id="trajetoria" aria-labelledby="trajetoria-titulo">
    <div class="wrap two-col">
      <div class="section-head reveal">
        <p class="eyebrow">Trajetória</p>
        <h2 id="trajetoria-titulo">Onde esse trabalho acontece</h2>
      </div>
      <ol class="timeline">
        {
          experience.map((item) => (
            <li class="reveal">
              <p class="timeline-period">{item.period}</p>
              <h3>{item.place}</h3>
              <p class="timeline-role">{item.role}</p>
              <p>{item.text}</p>
              {item.project && (
                <a class="arrow-link" href={projectUrl(item.project)}>
                  {getProject(item.project).title}
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="competencias" aria-labelledby="competencias-titulo">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Competências</p>
        <h2 id="competencias-titulo">O que eu sei fazer, e onde dá para conferir</h2>
      </div>
      <ul class="caps">
        {
          capabilities.map((capability) => (
            <li class="cap reveal">
              <h3>{capability.title}</h3>
              <p>{capability.text}</p>
              <ul class="cap-evidence">
                {capability.evidence.map((item) => (
                  <li>
                    <a href={projectUrl(item.project)}>{getProject(item.project).title}</a>
                    <span>{item.note}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="sobre" aria-labelledby="sobre-titulo">
    <div class="wrap two-col">
      <div class="section-head reveal">
        <p class="eyebrow">Sobre</p>
        <h2 id="sobre-titulo">Quem está por trás</h2>
      </div>
      <div class="about reveal">
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section contact" id="contato" aria-labelledby="contato-titulo">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Contato</p>
        <h2 id="contato-titulo">Vamos conversar</h2>
        <p>
          Estou disponível para oportunidades de desenvolvimento e para projetos sob demanda. O
          caminho mais rápido é uma mensagem no LinkedIn.
        </p>
      </div>
      <div class="hero-actions reveal">
        <a class="btn btn--primary" href={profile.links.linkedin} rel="me noopener">Escrever no LinkedIn</a>
        <a class="btn btn--ghost" href={profile.links.github} rel="me noopener">Ver o GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-block: clamp(40px, 7vw, 96px) clamp(48px, 7vw, 96px);
    overflow: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    gap: clamp(24px, 3vw, 48px);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  .hero-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-3);
  }

  .hero-art {
    min-width: 0;
  }

  /* Destaques */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding-block: clamp(28px, 4vw, 48px);
    border-top: 1px solid var(--line);
  }

  .feature--flip .feature-copy {
    order: 2;
  }

  .feature-copy {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .feature-copy > p:not(.tag) {
    color: var(--text-2);
  }

  .feature h3 {
    display: grid;
    gap: 6px;
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    letter-spacing: -0.025em;
  }

  .feature h3 a {
    text-decoration: none;
  }

  .feature h3 span {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--text-2);
  }

  .tag--olympus::before {
    background: var(--olympus);
  }

  .facts {
    display: grid;
    gap: 8px;
    font-size: 0.94rem;
  }

  .facts li {
    position: relative;
    padding-left: 20px;
  }

  .facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 2px;
    background: var(--signal);
  }

  .feature-visual {
    min-width: 0;
  }

  /* Linhas de ficha técnica */
  .rows {
    border-top: 1px solid var(--line);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 0.9fr) minmax(0, 1.4fr) max-content 24px;
    gap: 8px 24px;
    align-items: center;
    padding: 22px 12px 22px 16px;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.18s;
  }

  /* O "cabo" à esquerda energiza quando a linha recebe foco ou ponteiro. */
  .row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 14px;
    bottom: 14px;
    width: 3px;
    border-radius: 2px;
    background: var(--line-2);
    transition: background-color 0.18s;
  }

  .row:hover,
  .row:focus-within {
    background: var(--surface);
  }

  .row:hover::before,
  .row:focus-within::before {
    background: var(--signal);
  }

  .row-index,
  .row-kind {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-3);
  }

  .row-kind {
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .row h3 {
    font-size: 1.3rem;
  }

  .row h3 a {
    text-decoration: none;
  }

  /* A linha inteira é clicável; o link continua sendo o título. */
  .row h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row-sub {
    font-size: 0.92rem;
    color: var(--text-2);
  }

  .row-summary {
    font-size: 0.94rem;
    color: var(--text-2);
  }

  .row-arrow {
    color: var(--text-3);
    transition:
      transform 0.18s var(--ease),
      color 0.18s;
  }

  .row:hover .row-arrow,
  .row:focus-within .row-arrow {
    color: var(--signal);
    transform: translateX(4px);
  }

  /* Trajetória e Sobre */
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }

  .two-col .section-head {
    margin-bottom: 0;
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  .timeline {
    display: grid;
    gap: 36px;
    padding-left: 22px;
    border-left: 2px solid var(--line-2);
  }

  .timeline li {
    position: relative;
    display: grid;
    gap: 6px;
    justify-items: start;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: -29px;
    top: 6px;
    width: 12px;
    height: 12px;
    background: var(--signal);
    border: 3px solid var(--bg-2);
    border-radius: 50%;
  }

  .timeline-period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-3);
  }

  .timeline-role {
    font-weight: 600;
    color: var(--text);
  }

  .timeline li > p:not([class]) {
    color: var(--text-2);
    max-width: 38rem;
  }

  .about {
    display: grid;
    gap: 18px;
    max-width: 40rem;
    font-size: 1.05rem;
    color: var(--text-2);
  }

  .about p:first-child {
    color: var(--text);
  }

  /* Competências */
  .caps {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .cap {
    grid-column: span 2;
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 28px 28px 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .cap:nth-child(n + 4) {
    grid-column: span 3;
  }

  .cap > p {
    color: var(--text-2);
    font-size: 0.96rem;
  }

  .cap-evidence {
    display: grid;
    gap: 6px;
    margin-top: 4px;
    font-size: 0.9rem;
  }

  .cap-evidence li {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    align-items: baseline;
    padding-left: 14px;
    border-left: 2px solid var(--signal);
  }

  .cap-evidence a {
    font-weight: 600;
  }

  .cap-evidence span {
    color: var(--text-2);
  }

  .contact .section-head {
    margin-bottom: 28px;
  }

  @media (max-width: 960px) {
    .hero-grid,
    .feature,
    .two-col {
      grid-template-columns: 1fr;
    }

    .feature--flip .feature-copy {
      order: 0;
    }

    .two-col .section-head {
      position: static;
    }

    .row {
      grid-template-columns: 36px minmax(0, 1fr) 24px;
    }

    .row-summary,
    .row-kind {
      grid-column: 2 / 3;
    }

    .row-arrow {
      grid-column: 3;
      grid-row: 1;
    }

    .cap,
    .cap:nth-child(n + 4) {
      grid-column: span 3;
    }
  }

  @media (max-width: 620px) {
    .row {
      grid-template-columns: minmax(0, 1fr) 24px;
      padding-left: 18px;
    }

    .row-index {
      display: none;
    }

    .row-summary,
    .row-kind {
      grid-column: 1 / -1;
    }

    .row-arrow {
      grid-column: 2;
    }

    .cap,
    .cap:nth-child(n + 4) {
      grid-column: 1 / -1;
      padding-right: 0;
    }

    .hero-actions .btn--primary {
      flex: 1 1 100%;
    }
  }
</style>
